                        "elements": [
                            {
                                "type": "text",
                                "text": "Cette semaine, j’ai participé à un “makeathon” de l’organisation "
                            },
                            {
                                "type": "link",
                                "url": "https:\/\/tomglobal.org",
                                "text": "TOM"
                            },
                            {
                                "type": "text",
                                "text": " traitant du handicap, avec O. et l’équipe d’"
                            },
                            {
                                "type": "link",
                                "url": "https:\/\/abys-medical.com",
                                "text": "Abys Medical"
                            },
                            {
                                "type": "text",
                                "text": ". Notre équipe devait trouver une solution pour que Jonathan puisse naviguer dans le “Metavers” en adaptant l’interface VR controller classique à ses appareils de contrôle (trackball et interface utilisant le souffle, "
                            },
                            {
                                "type": "text",
                                "text": "Note : la partie “Neuro” n’a pas pu être utilisée faute de temps, ce sera pour une prochaine itération ;-)",
                                "style": {
                                    "italic": true
                                }
                            },
                            {
                                "type": "text",
                                "text": ")"
                            }
                        ]
                    }
