        "client_msg_id": "d70e9498-a550-4f74-9eb4-25847a47df85",
        "text": "J’ai trouvé une publication sur une expérimentation de type _smarthome indoor localization_ :  <https:\/\/www.mdpi.com\/2076-3417\/11\/1\/415\/htm>",
        "team": "T03FC4NDZ",
        "user_team": "T03FC4NDZ",
        "source_team": "T03FC4NDZ",
        "user_profile": {
            "avatar_hash": "1602c595b4f6",
            "image_72": "https:\/\/avatars.slack-edge.com\/2020-04-30\/1097117343618_1602c595b4f6f5ec2125_72.jpg",
            "first_name": "Hans",
            "real_name": "Hans Harisson",
            "display_name": "hans",
            "team": "T03FC4NDZ",
            "name": "hans",
            "is_restricted": false,
            "is_ultra_restricted": false
        },
        "thread_ts": "1616161417.009300",
        "parent_user_id": "UAMPR1P5L",
        "attachments": [
            {
                "service_name": "MDPI",
                "title": "Feasibility of LoRa for Smart Home Indoor Localization",
                "title_link": "https:\/\/www.mdpi.com\/2076-3417\/11\/1\/415\/htm",
                "text": "With the advancement of low-power and low-cost wireless technologies in the past few years, the Internet of Things (IoT) has been growing rapidly in numerous areas of Industry 4.0 and smart homes. With the development of many applications for the IoT, indoor localization, i.e., the capability to determine the physical location of people or devices, has become an important component of smart homes. Various wireless technologies have been used for indoor localization including WiFi, ultra-wideband (UWB), Bluetooth low energy (BLE), radio-frequency identification (RFID), and LoRa. The ability of low-cost long range (LoRa) radios for low-power and long-range communication has made this radio technology a suitable candidate for many indoor and outdoor IoT applications. Additionally, research studies have shown the feasibility of localization with LoRa radios. However, indoor localization with LoRa is not adequately explored at the home level, where the localization area is relatively smaller than offices and corporate buildings. In this study, we first explore the feasibility of ranging with LoRa. Then, we conduct experiments to demonstrate the capability of LoRa for accurate and precise indoor localization in a typical apartment setting. Our experimental results show that LoRa-based indoor localization has an accuracy better than 1.6 m in line-of-sight scenario and 3.2 m in extreme non-line-of-sight scenario with a precision better than 25 cm in all cases, without using any data filtering on the location estimates.",
                "fallback": "MDPI: Feasibility of LoRa for Smart Home Indoor Localization",
                "thumb_url": "https:\/\/www.mdpi.com\/img\/journals\/applsci-logo-sq.png?1693b1ae19024e2e",
                "from_url": "https:\/\/www.mdpi.com\/2076-3417\/11\/1\/415\/htm",
                "thumb_width": 160,
                "thumb_height": 160,
                "service_icon": "https:\/\/www.mdpi.com\/icon\/apple-touch-icon-180x180.png",
                "id": 1,
                "original_url": "https:\/\/www.mdpi.com\/2076-3417\/11\/1\/415\/htm"
            }
        ],
