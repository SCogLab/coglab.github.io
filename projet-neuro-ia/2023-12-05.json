        "attachments": [
            {
                "from_url": "https:\/\/www.biorxiv.org\/content\/10.1101\/2023.09.06.556482v3",
                "service_icon": "https:\/\/www.biorxiv.org\/sites\/default\/files\/images\/favicon.ico",
                "thumb_url": "https:\/\/www.biorxiv.org\/sites\/default\/files\/images\/biorxiv_logo_homepage7-5-small.png",
                "thumb_width": 252,
                "thumb_height": 252,
                "ts": 1701763200,
                "id": 1,
                "original_url": "https:\/\/www.biorxiv.org\/content\/10.1101\/2023.09.06.556482v3",
                "fallback": "bioRxiv: Super Bowl, an open platform for visual stimulation of insects",
                "text": "To study how the nervous system processes visual information, experimenters must record neural activity while delivering visual stimuli in a controlled fashion. In animals with a nearly panoramic field of view, such as flies, precise stimulation of the entire visual field is challenging. We describe a projector-based device for stimulation of the insect visual system under a microscope. The device is based on a bowl-shaped screen that provides a wide and nearly distortion-free field of view. It is compact, cheap, easy to assemble, and easy to operate using the included open-source software for stimulus generation. We validate the virtual reality system technically and demonstrate its capabilities in a series of experiments at two levels: the cellular, by measuring the membrane potential responses of visual interneurons; and the organismal, by recording optomotor and fixation behavior of Drosophila melanogaster in tethered flight. Our experiments reveal the importance of stimulating the visual system of an insect with a wide field of view, and we provide a simple solution to do so.\n\n### Competing Interest Statement\n\nThe authors have declared no competing interest.",
                "title": "Super Bowl, an open platform for visual stimulation of insects",
                "title_link": "https:\/\/www.biorxiv.org\/content\/10.1101\/2023.09.06.556482v3",
                "service_name": "bioRxiv"
            }
        ],
