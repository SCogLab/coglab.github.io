                "type": "rich_text",
                "block_id": "7rPK",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Pour compléter, notre idée de la calibration consistait à utilisé l'indice de "
                            },
                            {
                                "type": "text",
                                "text": "qualités",
                                "style": {
                                    "bold": true
                                }
                            },
                            {
                                "type": "text",
                                "text": " des électrodes invoqué avec la fonction useQualities() du SDK :\n"
                            },
                            {
                                "type": "link",
                                "url": "https:\/\/github.com\/mbt-administrator\/DemoSDK.Android\/#eeg-features"
                            },
                            {
                                "type": "text",
                                "text": "\n\nCe qui correspond à la première partie de la réponse de Sophie."
                            }
                        ]
