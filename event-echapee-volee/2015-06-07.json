                                "type": "emoji",
                                "name": "simple_smile"
                            },
                            {
                                "type": "text",
                                "text": "\nVoici un support à votre disposition, je vais préparer les albums Flickr\n"
                            },
                            {
                                "type": "link",
                                "url": "https:\/\/coglab.hackpad.com\/CR-Lchappe-Vole-YhRmdM1JFHz"
